[Unit]
Description=Companion conversation executor (pi-agent-core; no provider key, Unix sockets only)
Requires=companion-authority.service companion-model.service
After=companion-authority.service companion-model.service

# Runs as the companion user WITHOUT filesystem isolation: an unprivileged user
# manager on home-agent silently skips mount/namespace options (ProtectSystem,
# ReadWritePaths, PrivateNetwork, ...), so none are listed here. Only seccomp-
# and prctl-based options take effect: network is restricted to Unix sockets.
# The model can reach only companion_scope/companion_content, which have no
# filesystem access.
[Service]
Type=exec
ExecStart=%h/.local/opt/companion/bin/node %h/src/companion/current/capabilities/conversation/conversation.mjs --config %h/.local/share/companion-world-v1/operator/conversation.json
UMask=0077
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
KillMode=control-group
TimeoutStopSec=15s
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=default.target
