[Unit]
Description=Capability DSH and inner socket proxy in a rootless sandbox
Requires=companion-authority.service companion-model.service
After=companion-authority.service companion-model.service

[Service]
Type=exec
Sockets=companion-dsh-internal.socket
ExecStart=/usr/bin/python3 %h/src/dsh-companion/authority-0.10.0/ops/isolation/launch.py capability
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStopSec=15s
