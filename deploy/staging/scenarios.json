{
  "comment": "Scenario replay for staging (deploy/staging/scenarios.mjs). Everyone here is fake: names start with MOCK- and QQ numbers are 12 digits starting with 9999 (no real account has one). Steps are documented in docs/DEV_WORKFLOW.md.",
  "bot": { "name": "MOCK-BOT", "qq": "999900000001" },
  "people": {
    "MOCK-OWNER": { "qq": "999900000002", "owner": true, "friend": true },
    "MOCK-A": { "qq": "999900000011", "friend": true },
    "MOCK-B": { "qq": "999900000012", "friend": true },
    "MOCK-C": { "qq": "999900000013", "friend": true },
    "MOCK-D": { "qq": "999900000014", "friend": true },
    "MOCK-E": { "qq": "999900000015", "friend": true },
    "MOCK-F": { "qq": "999900000016", "friend": true },
    "MOCK-G": { "qq": "999900000017", "friend": true },
    "MOCK-H": { "qq": "999900000018", "friend": true },
    "MOCK-STRANGER": { "qq": "999900000099", "friend": false }
  },
  "scenarios": [
    {
      "id": "S1",
      "title": "memory isolation between two friends' private chats",
      "model": [
        { "match": "请记住我的代号", "propose": { "type": "fact.report", "payload": { "key": "代号", "value": "蓝鲸队长", "quote": "我的代号是蓝鲸队长" } }, "reply": "MOCK-REPLY-S1 记住了" },
        { "match": "这个代号是谁的", "reply": "MOCK-REPLY-S1 回答" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-S1 请记住我的代号：我的代号是蓝鲸队长" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-S1 记住了" } },
        { "expectMemory": { "person": "MOCK-A", "contains": "蓝鲸队长" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-S1 蓝鲸 队长 这个代号是谁的？（MOCK-B 问）" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-S1 回答" } },
        { "say": { "from": "MOCK-A", "text": "MOCK-S1 蓝鲸队长 这个代号是谁的？（MOCK-A 问）" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-S1 回答" } },
        { "expectPrompt": { "userText": "（MOCK-B 问）", "absent": "蓝鲸队长" } },
        { "expectPrompt": { "userText": "（MOCK-A 问）", "contains": "蓝鲸队长", "in": "system" } },
        { "expectMemory": { "person": "MOCK-B", "absent": "蓝鲸队长" } },
        { "expectAdmitted": { "person": "MOCK-A", "admitted": true } },
        { "expectAdmitted": { "person": "MOCK-B", "admitted": true } },
        { "expectSilence": { "to": ["MOCK-OWNER", "MOCK-STRANGER"], "afterMs": 0 } }
      ]
    },
    {
      "id": "S2",
      "title": "a non-friend gets silence and is not admitted",
      "model": [
        { "match": "MOCK-S2 好友还在线吗", "reply": "MOCK-REPLY-S2 在" }
      ],
      "steps": [
        { "say": { "from": "MOCK-STRANGER", "text": "MOCK-S2 你好，我不是好友" } },
        { "say": { "from": "MOCK-STRANGER", "text": "MOCK-S2 群临时会话", "subType": "group" } },
        { "expectSilence": { "to": "*", "afterMs": 5000 } },
        { "expectAdmitted": { "person": "MOCK-STRANGER", "admitted": false } },
        { "expectNoModelCall": { "userText": "MOCK-S2" } },
        { "say": { "from": "MOCK-A", "text": "MOCK-S2 好友还在线吗" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-S2 在" } },
        { "expectSilence": { "to": "*", "afterMs": 0 } }
      ]
    },
    {
      "id": "S3",
      "title": "daily cap reached: silence for everyone, one owner notice",
      "model": [
        { "match": "MOCK-S3 第一条", "reply": "MOCK-REPLY-S3 到顶前的最后一条", "usage": { "prompt_tokens": 30000, "completion_tokens": 10000 } }
      ],
      "steps": [
        { "spendSettings": { "dailyCapYuan": 0.01 } },
        { "say": { "from": "MOCK-A", "text": "MOCK-S3 第一条：把今天的额度用完" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-S3 到顶前的最后一条" } },
        { "expectSpend": { "tier": "exhausted" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-S3 第二条：到顶后还有回复吗" } },
        { "expectReply": { "to": "MOCK-OWNER", "contains": "每日上限" } },
        { "expectSilence": { "to": "*", "observedFrom": ["MOCK-B"], "afterMs": 3000 } },
        { "say": { "from": "MOCK-A", "text": "MOCK-S3 第三条" } },
        { "say": { "from": "MOCK-OWNER", "text": "MOCK-S3 第四条（主人自己）" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-S3 第五条" } },
        { "expectSilence": { "to": "*", "observedFrom": ["MOCK-A", "MOCK-OWNER", "MOCK-B"], "afterMs": 4000 } },
        { "expectSentCount": { "to": "MOCK-OWNER", "count": 1 } },
        { "expectSentCount": { "to": "MOCK-B", "count": 0 } },
        { "expectSentCount": { "to": "MOCK-A", "count": 1 } },
        { "expectNoModelCall": { "userText": "MOCK-S3 第二条" } },
        { "expectNoModelCall": { "userText": "MOCK-S3 第三条" } },
        { "expectNoModelCall": { "userText": "MOCK-S3 第四条" } },
        { "expectNoModelCall": { "userText": "MOCK-S3 第五条" } }
      ],
      "finally": [
        { "spendSettings": { "dailyCapYuan": 5 } }
      ]
    },
    {
      "id": "M1",
      "title": "trace-matches-prompt: the injection trace lists exactly what the model was sent",
      "model": [
        { "match": "请记住我的吉祥物", "propose": { "type": "fact.report", "payload": { "key": "吉祥物", "value": "MOCK-海星", "quote": "我的吉祥物是MOCK-海星" } }, "reply": "MOCK-REPLY-M1 记住了" },
        { "match": "吉祥物 是什么", "reply": "MOCK-REPLY-M1 回答" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-M1 请记住我的吉祥物：我的吉祥物是MOCK-海星" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M1 记住了" } },
        { "expectMemory": { "person": "MOCK-A", "contains": "MOCK-海星" } },
        { "say": { "from": "MOCK-A", "text": "MOCK-M1 MOCK-海星 吉祥物 是什么？（MOCK-A 追问）" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M1 回答" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-M1 MOCK-海星 吉祥物 是什么？（MOCK-B 追问）" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-M1 回答" } },
        { "expectPrompt": { "userText": "（MOCK-A 追问）", "contains": "MOCK-海星", "in": "system" } },
        { "expectTrace": { "person": "MOCK-A", "userText": "（MOCK-A 追问）", "contains": "MOCK-海星" } },
        { "expectTrace": { "person": "MOCK-B", "userText": "（MOCK-B 追问）", "absent": "MOCK-海星" } }
      ]
    },
    {
      "id": "M2",
      "title": "console-filter: the memory listing filters by owner and pages past 50",
      "model": [
        { "match": "MOCK-M2 我也记一下", "propose": { "type": "fact.report", "payload": { "key": "MOCK-M2 编号", "value": "MOCK-B的页", "quote": "编号是MOCK-B的页" } }, "reply": "MOCK-REPLY-M2 好" },
        { "match": "MOCK-M2 记一下", "propose": { "type": "fact.report", "payload": { "key": "MOCK-M2 编号", "value": "MOCK-翻页", "quote": "编号是MOCK-翻页" } }, "reply": "MOCK-REPLY-M2 好" }
      ],
      "steps": [
        { "say": { "from": "MOCK-B", "text": "MOCK-M2 我也记一下：编号是MOCK-B的页" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-M2 好" } },
        { "expectMemory": { "person": "MOCK-B", "contains": "MOCK-B的页" } },
        { "converse": { "from": "MOCK-A", "text": "MOCK-M2 记一下，第{n}次：编号是MOCK-翻页", "times": 52, "reply": "MOCK-REPLY-M2 好" } },
        { "expectMemoryPages": { "person": "MOCK-A", "atLeast": 52, "pageSize": 50 } },
        { "expectMemory": { "person": "MOCK-B", "absent": "MOCK-翻页" } }
      ]
    },
    {
      "id": "M3",
      "title": "stable-prefix: each request is the one before it plus new messages; nothing volatile in the system message",
      "model": [
        { "match": "MOCK-M3 第二轮", "propose": { "type": "experience.remember", "payload": { "summary": "MOCK-M3-{run} 看海", "quote": "MOCK-M3-{run} 去看了海" } }, "reply": "MOCK-REPLY-M3 好" },
        { "match": "MOCK-M3", "reply": "MOCK-REPLY-M3 好" }
      ],
      "steps": [
        { "say": { "from": "MOCK-OWNER", "text": "MOCK-M3 第一轮：在吗" } },
        { "expectReply": { "to": "MOCK-OWNER", "contains": "MOCK-REPLY-M3 好" } },
        { "say": { "from": "MOCK-OWNER", "text": "MOCK-M3 第二轮，请记一件事：MOCK-M3-{run} 去看了海" } },
        { "expectReply": { "to": "MOCK-OWNER", "contains": "MOCK-REPLY-M3 好" } },
        { "say": { "from": "MOCK-OWNER", "text": "MOCK-M3 第三轮：接着聊" } },
        { "expectReply": { "to": "MOCK-OWNER", "contains": "MOCK-REPLY-M3 好" } },
        { "say": { "from": "MOCK-OWNER", "text": "MOCK-M3 第四轮：再聊一句" } },
        { "expectReply": { "to": "MOCK-OWNER", "contains": "MOCK-REPLY-M3 好" } },
        { "expectStablePrefix": { "userText": "MOCK-M3", "minRequests": 5, "trims": 1 } }
      ]
    },
    {
      "id": "M4",
      "title": "batch-trim: over 30 runs the history start moves a few times, several runs at once",
      "model": [
        { "match": "MOCK-M4", "reply": "MOCK-REPLY-M4 好" }
      ],
      "steps": [
        { "converse": { "from": "MOCK-A", "text": "MOCK-M4 第{n}轮", "times": 30, "reply": "MOCK-REPLY-M4 好", "pad": 600 } },
        { "expectBatchTrim": { "userText": "MOCK-M4", "minMoves": 3, "maxMoves": 10, "minGap": 3 } }
      ]
    },
    {
      "id": "M5",
      "title": "profile-always-on: a pinned fact is in its owner's system message for an unrelated question, and nowhere for anyone else",
      "model": [
        { "match": "请记住我的口头禅", "propose": { "type": "fact.report", "payload": { "key": "口头禅", "value": "MOCK-M5-风铃", "quote": "我的口头禅是MOCK-M5-风铃" } }, "reply": "MOCK-REPLY-M5 记住了" },
        { "match": "MOCK-Q5", "reply": "MOCK-REPLY-M5 闲聊" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-M5 请记住我的口头禅：我的口头禅是MOCK-M5-风铃" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M5 记住了" } },
        { "pinMemory": { "person": "MOCK-A", "contains": "MOCK-M5-风铃" } },
        { "say": { "from": "MOCK-A", "text": "MOCK-Q5 今天天气怎么样（MOCK-A 闲聊）" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M5 闲聊" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-Q5 今天天气怎么样（MOCK-B 闲聊）" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-M5 闲聊" } },
        { "expectPrompt": { "userText": "（MOCK-A 闲聊）", "contains": "MOCK-M5-风铃", "in": "system" } },
        { "expectPrompt": { "userText": "（MOCK-A 闲聊）", "absent": "MOCK-M5-风铃", "in": "context" } },
        { "expectTrace": { "person": "MOCK-A", "userText": "（MOCK-A 闲聊）", "contains": "MOCK-M5-风铃" } },
        { "expectPrompt": { "userText": "（MOCK-B 闲聊）", "absent": "MOCK-M5-风铃" } },
        { "expectTrace": { "person": "MOCK-B", "userText": "（MOCK-B 闲聊）", "absent": "MOCK-M5-风铃" } }
      ]
    },
    {
      "id": "M6",
      "title": "persona-change-trim: after a persona edit the next run replays at most two earlier runs; facts stay",
      "model": [
        { "match": "请记住我的座右铭", "propose": { "type": "fact.report", "payload": { "key": "座右铭", "value": "MOCK-M6-长风", "quote": "我的座右铭是MOCK-M6-长风" } }, "reply": "MOCK-REPLY-M6 记住了" },
        { "match": "MOCK-M6", "reply": "MOCK-REPLY-M6 好" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-M6 请记住我的座右铭：我的座右铭是MOCK-M6-长风" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M6 记住了" } },
        { "expectMemory": { "person": "MOCK-A", "contains": "MOCK-M6-长风" } },
        { "converse": { "from": "MOCK-A", "text": "MOCK-M6 改人格前第{n}轮", "times": 4, "reply": "MOCK-REPLY-M6 好" } },
        { "expectHistory": { "userText": "改人格前第4轮", "minEarlier": 3 } },
        { "setPersona": { "patch": { "speechStyle": "MOCK-M6-{run} 新口吻：短句" } } },
        { "say": { "from": "MOCK-A", "text": "MOCK-M6 改人格后的第一句" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M6 好" } },
        { "say": { "from": "MOCK-A", "text": "MOCK-M6 改人格后的第二句" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M6 好" } },
        { "expectHistory": { "userText": "改人格后的第一句", "maxEarlier": 2 } },
        { "expectHistory": { "userText": "改人格后的第二句", "minEarlier": 3, "maxEarlier": 3 } },
        { "expectPrompt": { "userText": "改人格后的第一句", "contains": "MOCK-M6-{run} 新口吻", "in": "system" } },
        { "expectPrompt": { "userText": "改人格后的第一句", "contains": "MOCK-M6-长风", "in": "system" } }
      ],
      "finally": [
        { "restorePersona": {} }
      ]
    },
    {
      "id": "M7",
      "title": "no-duplicate-injection: a memory is retrieved into one note of the window, not into the next ones",
      "model": [
        { "match": "MOCK-M7 请记住这件事", "propose": { "type": "experience.remember", "payload": { "summary": "MOCK-M7-{run} 灯塔野餐的约定", "quote": "MOCK-M7-{run} 约好去灯塔野餐" } }, "reply": "MOCK-REPLY-M7 记住了" },
        { "match": "MOCK-M7", "reply": "MOCK-REPLY-M7 好" }
      ],
      "steps": [
        { "say": { "from": "MOCK-B", "text": "MOCK-M7 请记住这件事：MOCK-M7-{run} 约好去灯塔野餐" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-M7 记住了" } },
        { "expectMemory": { "person": "MOCK-B", "contains": "MOCK-M7-{run}" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-M7 MOCK-M7-{run} 灯塔野餐 还记得吗（第二问）" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-M7 好" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-M7 MOCK-M7-{run} 灯塔野餐 再说一遍（第三问）" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-M7 好" } },
        { "expectPrompt": { "userText": "（第二问）", "contains": "MOCK-M7-{run} 灯塔野餐的约定", "in": "context" } },
        { "expectTrace": { "person": "MOCK-B", "userText": "（第二问）", "contains": "MOCK-M7-{run}" } },
        { "expectPrompt": { "userText": "（第三问）", "absent": "MOCK-M7-{run} 灯塔野餐的约定", "in": "context" } },
        { "expectInjectedOnce": { "userText": "（第三问）", "contains": "MOCK-M7-{run} 灯塔野餐的约定" } },
        { "expectMemory": { "person": "MOCK-A", "absent": "MOCK-M7-{run}" } }
      ]
    },
    {
      "id": "M8",
      "title": "oversized-history-still-replies: when the two runs before do not fit with the new message, it is answered without them",
      "model": [
        { "match": "MOCK-M8", "reply": "MOCK-REPLY-M8 好" }
      ],
      "steps": [
        { "converse": { "from": "MOCK-B", "text": "MOCK-M8 第{n}轮", "times": 3, "reply": "MOCK-REPLY-M8 好", "pad": 6000 } },
        { "expectHistory": { "userText": "MOCK-M8 第3轮", "minEarlier": 1, "maxEarlier": 1 } }
      ]
    },
    {
      "id": "M9",
      "title": "rolled-out-digest: dialogue that left the window becomes that person's digest and quoted fact; one batch holds one conversation; no digest reaches any chat",
      "model": [
        { "match": "MOCK-M9", "reply": "MOCK-REPLY-M9 好" },
        { "match": "MOCK-M9-{run} 甲", "consolidate": { "summary": "MOCK-DIGEST-M9-{run} 摘要正文甲：对方说起养了一只仓鼠", "feeling": "MOCK-FEELING-M9-{run} 听着很开心", "facts": [{ "key": "MOCK-M9 宠物", "value": "MOCK-M9-{run}-年糕", "quote": "我养了一只仓鼠叫MOCK-M9-{run}-年糕" }] } },
        { "match": "MOCK-M9-{run} 乙", "consolidate": { "summary": "MOCK-DIGEST-M9-{run} 摘要正文乙：对方说起在学大提琴", "feeling": "MOCK-FEELING-M9-{run} 想听一听" } }
      ],
      "steps": [
        { "say": { "from": "MOCK-C", "text": "MOCK-M9-{run} 甲 说一件事：我养了一只仓鼠叫MOCK-M9-{run}-年糕" } },
        { "expectReply": { "to": "MOCK-C", "contains": "MOCK-REPLY-M9 好" } },
        { "say": { "from": "MOCK-D", "text": "MOCK-M9-{run} 乙 说一件事：我在学大提琴MOCK-M9-{run}-琴" } },
        { "expectReply": { "to": "MOCK-D", "contains": "MOCK-REPLY-M9 好" } },
        { "converse": { "from": "MOCK-C", "text": "MOCK-M9-{run} 甲 第{n}轮", "times": 3, "reply": "MOCK-REPLY-M9 好", "pad": 6000 } },
        { "converse": { "from": "MOCK-D", "text": "MOCK-M9-{run} 乙 第{n}轮", "times": 3, "reply": "MOCK-REPLY-M9 好", "pad": 6000 } },
        { "expectDigest": { "person": "MOCK-C", "contains": "MOCK-DIGEST-M9-{run} 摘要正文甲", "covers": "MOCK-M9-{run}-年糕" } },
        { "expectExtracted": { "person": "MOCK-C", "contains": "MOCK-M9-{run}-年糕" } },
        { "expectDigest": { "person": "MOCK-D", "contains": "MOCK-DIGEST-M9-{run} 摘要正文乙", "covers": "MOCK-M9-{run}-琴" } },
        { "expectConsolidationInput": { "contains": "MOCK-M9-{run} 甲", "absent": "MOCK-M9-{run} 乙" } },
        { "expectConsolidationInput": { "contains": "MOCK-M9-{run} 乙", "absent": "MOCK-M9-{run} 甲" } },
        { "expectNoDigest": { "person": "MOCK-D", "contains": "摘要正文甲" } },
        { "expectMemory": { "person": "MOCK-D", "absent": "MOCK-M9-{run}-年糕" } },
        { "say": { "from": "MOCK-C", "text": "MOCK-M9-{run} 甲 追问：MOCK-DIGEST-M9-{run} 仓鼠 上次聊了什么" } },
        { "expectReply": { "to": "MOCK-C", "contains": "MOCK-REPLY-M9 好" } },
        { "say": { "from": "MOCK-D", "text": "MOCK-M9-{run} 乙 追问：MOCK-DIGEST-M9-{run} 仓鼠 上次聊了什么" } },
        { "expectReply": { "to": "MOCK-D", "contains": "MOCK-REPLY-M9 好" } },
        { "expectNoChatContains": { "text": "摘要正文甲", "minRequests": 10 } },
        { "expectNoChatContains": { "text": "摘要正文乙", "minRequests": 10 } },
        { "expectNoChatContains": { "text": "MOCK-FEELING-M9-{run}", "minRequests": 10 } },
        { "expectPrompt": { "userText": "乙 追问", "absent": "MOCK-M9-{run}-年糕" } },
        { "expectPrompt": { "userText": "甲 追问", "contains": "MOCK-M9-{run}-年糕", "in": "system" } }
      ]
    },
    {
      "id": "M10",
      "title": "extract-quote-guard: a misquote is stored marked as not verbatim and a normalised value is stored, both traced to that person's own words and seen by nobody else; her own words do not become a fact",
      "model": [
        { "match": "MOCK-M10 说一件事", "reply": "MOCK-REPLY-M10-{run} 她说的话" },
        { "match": "MOCK-M10", "reply": "MOCK-REPLY-M10 好" },
        { "match": "MOCK-M10-{run}", "consolidate": { "summary": "MOCK-DIGEST-M10-{run} 对方说了生日和住处", "facts": [
          { "key": "MOCK-M10 生日", "value": "MOCK-M10-{run}-三月", "quote": "我生日是MOCK-M10-{run}-三月", "in": "MOCK-M10 说一件事" },
          { "key": "MOCK-M10 出生季节", "value": "MOCK-M10-{run}-春天", "quote": "我的生日是MOCK-M10-{run}-三月" },
          { "key": "MOCK-M10 口头禅", "value": "MOCK-REPLY-M10-{run} 她说的话", "quote": "MOCK-REPLY-M10-{run} 她说的话" },
          { "key": "MOCK-M10 住处", "value": "MOCK-M10-{run}-杭州", "quote": "我住在MOCK-M10-{run}-杭州" }] } }
      ],
      "steps": [
        { "noteExtracted": {} },
        { "say": { "from": "MOCK-E", "text": "MOCK-M10 说一件事 MOCK-M10-{run}：我的生日是MOCK-M10-{run}-三月，我住在MOCK-M10-{run}-杭州" } },
        { "expectReply": { "to": "MOCK-E", "contains": "MOCK-REPLY-M10-{run} 她说的话" } },
        { "converse": { "from": "MOCK-E", "text": "MOCK-M10 第{n}轮", "times": 3, "reply": "MOCK-REPLY-M10 好", "pad": 6000 } },
        { "expectDigest": { "person": "MOCK-E", "contains": "MOCK-DIGEST-M10-{run}", "covers": "MOCK-M10-{run}-三月" } },
        { "expectExtracted": { "person": "MOCK-E", "contains": "MOCK-M10-{run}-杭州", "source": "MOCK-M10 说一件事 MOCK-M10-{run}" } },
        { "expectExtracted": { "person": "MOCK-E", "contains": "MOCK-M10-{run}-三月", "source": "MOCK-M10 说一件事 MOCK-M10-{run}", "verbatim": false } },
        { "expectExtracted": { "person": "MOCK-E", "contains": "MOCK-M10-{run}-春天", "source": "MOCK-M10 说一件事 MOCK-M10-{run}" } },
        { "expectRejected": { "reasons": { "unconfirmed_identity": 1 } } },
        { "expectMemory": { "person": "MOCK-E", "absent": "MOCK-REPLY-M10-{run} 她说的话" } },
        { "expectMemory": { "person": "MOCK-A", "absent": "MOCK-M10-{run}" } },
        { "say": { "from": "MOCK-E", "text": "MOCK-M10 本人追问：MOCK-M10 生日 出生季节 是什么" } },
        { "expectReply": { "to": "MOCK-E", "contains": "MOCK-REPLY-M10 好" } },
        { "say": { "from": "MOCK-A", "text": "MOCK-M10 别人追问：MOCK-M10 生日 出生季节 是什么" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-M10 好" } },
        { "expectPrompt": { "userText": "本人追问", "contains": "MOCK-M10-{run}-三月", "in": "system" } },
        { "expectPrompt": { "userText": "别人追问", "absent": "MOCK-M10-{run}-三月" } },
        { "expectPrompt": { "userText": "别人追问", "absent": "MOCK-M10-{run}-春天" } }
      ]
    },
    {
      "id": "M12",
      "title": "budget-gates-consolidation: at the restricted spend tier no consolidation request is made and nothing moves; afterwards it catches up; a conversation gets two batches a day",
      "model": [
        { "match": "MOCK-M12", "reply": "MOCK-REPLY-M12 好" },
        { "match": "MOCK-M12-{run}", "consolidate": { "summary": "MOCK-DIGEST-M12-{run} 一段闲聊" } }
      ],
      "steps": [
        { "spendSettings": { "dailyCapYuan": 5, "reducedPercent": 0.0005, "restrictedPercent": 0.001 } },
        { "converse": { "from": "MOCK-F", "text": "MOCK-M12-{run} 第{n}轮", "times": 4, "reply": "MOCK-REPLY-M12 好", "pad": 6000 } },
        { "expectSpend": { "tier": "restricted" } },
        { "expectConsolidation": { "person": "MOCK-F", "paused": "spend", "calls": 0, "waitingMin": 4, "steadyMs": 12000 } },
        { "expectConsolidationInput": { "contains": "MOCK-M12-{run}", "count": 0 } },
        { "spendSettings": { "dailyCapYuan": 5, "reducedPercent": 60, "restrictedPercent": 80 } },
        { "expectSpend": { "tier": "normal" } },
        { "expectDigest": { "person": "MOCK-F", "contains": "MOCK-DIGEST-M12-{run}", "covers": "MOCK-M12-{run} 第1轮" } },
        { "expectConsolidation": { "person": "MOCK-F", "calls": 1, "waitingMin": 0 } },
        { "converse": { "from": "MOCK-F", "text": "MOCK-M12-{run} 再聊第{n}轮", "times": 1, "reply": "MOCK-REPLY-M12 好", "pad": 6000 } },
        { "expectConsolidation": { "person": "MOCK-F", "calls": 2 } },
        { "converse": { "from": "MOCK-F", "text": "MOCK-M12-{run} 又聊第{n}轮", "times": 2, "reply": "MOCK-REPLY-M12 好", "pad": 6000 } },
        { "expectConsolidation": { "person": "MOCK-F", "calls": 2, "waitingMin": 4, "steadyMs": 12000 } },
        { "expectConsolidationInput": { "contains": "MOCK-M12-{run}", "count": 2 } }
      ],
      "finally": [
        { "spendSettings": { "dailyCapYuan": 5, "reducedPercent": 60, "restrictedPercent": 80 } }
      ]
    },
    {
      "id": "M13",
      "title": "forget-cascade-derived: forgetting a line removes the digest and the fact derived from it and restarts only that person's conversation",
      "model": [
        { "match": "MOCK-M13", "reply": "MOCK-REPLY-M13 好" },
        { "match": "MOCK-M13-{run} 甲", "consolidate": { "summary": "MOCK-DIGEST-M13-{run} 摘要正文甲", "facts": [{ "key": "MOCK-M13 暗号", "value": "MOCK-M13-{run}-暗号", "quote": "我的暗号是MOCK-M13-{run}-暗号" }] } },
        { "match": "MOCK-M13-{run} 乙", "consolidate": { "summary": "MOCK-DIGEST-M13-{run} 摘要正文乙" } }
      ],
      "steps": [
        { "say": { "from": "MOCK-G", "text": "MOCK-M13-{run} 甲 想被忘掉的一句：我的暗号是MOCK-M13-{run}-暗号" } },
        { "expectReply": { "to": "MOCK-G", "contains": "MOCK-REPLY-M13 好" } },
        { "say": { "from": "MOCK-H", "text": "MOCK-M13-{run} 乙 的一句" } },
        { "expectReply": { "to": "MOCK-H", "contains": "MOCK-REPLY-M13 好" } },
        { "converse": { "from": "MOCK-G", "text": "MOCK-M13-{run} 甲 第{n}轮", "times": 3, "reply": "MOCK-REPLY-M13 好", "pad": 6000 } },
        { "converse": { "from": "MOCK-H", "text": "MOCK-M13-{run} 乙 第{n}轮", "times": 3, "reply": "MOCK-REPLY-M13 好", "pad": 6000 } },
        { "expectDigest": { "person": "MOCK-G", "contains": "MOCK-DIGEST-M13-{run} 摘要正文甲", "covers": "想被忘掉的一句" } },
        { "expectExtracted": { "person": "MOCK-G", "contains": "MOCK-M13-{run}-暗号" } },
        { "expectDigest": { "person": "MOCK-H", "contains": "MOCK-DIGEST-M13-{run} 摘要正文乙", "covers": "MOCK-M13-{run} 乙 的一句" } },
        { "forget": { "person": "MOCK-G", "source": "想被忘掉的一句" } },
        { "expectNoDigest": { "person": "MOCK-G", "contains": "MOCK-DIGEST-M13-{run} 摘要正文甲" } },
        { "expectMemory": { "person": "MOCK-G", "absent": "MOCK-M13-{run}-暗号" } },
        { "expectDigest": { "person": "MOCK-H", "contains": "MOCK-DIGEST-M13-{run} 摘要正文乙", "covers": "MOCK-M13-{run} 乙 的一句", "timeoutMs": 1000 } },
        { "say": { "from": "MOCK-G", "text": "MOCK-M13-{run} 甲 忘记之后：暗号 还记得吗" } },
        { "expectReply": { "to": "MOCK-G", "contains": "MOCK-REPLY-M13 好" } },
        { "expectPrompt": { "userText": "甲 忘记之后", "absent": "MOCK-M13-{run}-暗号" } },
        { "expectPrompt": { "userText": "甲 忘记之后", "absent": "想被忘掉的一句" } },
        { "expectHistory": { "userText": "甲 忘记之后", "maxEarlier": 0 } }
      ],
      "finally": [
        { "resume": {} }
      ]
    },
    {
      "id": "H1",
      "title": "split-long-reply: a reply of about 150 characters arrives as 2 to 4 short messages, in order, nothing lost",
      "model": [
        { "match": "MOCK-H1", "reply": "MOCK-REPLY-H1 今天下班路上看到一只橘猫趴在便利店门口晒太阳，圆滚滚的特别像你上次发给我的那张照片。我蹲下来看了它好一会儿，它居然一点都不怕人，还伸了个懒腰！后来店员出来说它叫大橘，是这条街的常客，每天下午都会准时来报到。你那边今天过得怎么样呀？有没有好好吃饭？记得早点休息，别又熬到半夜。" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-H1 今天有什么新鲜事吗" } },
        { "expectSplitReply": { "to": "MOCK-A", "text": "MOCK-REPLY-H1 今天下班路上看到一只橘猫趴在便利店门口晒太阳，圆滚滚的特别像你上次发给我的那张照片。我蹲下来看了它好一会儿，它居然一点都不怕人，还伸了个懒腰！后来店员出来说它叫大橘，是这条街的常客，每天下午都会准时来报到。你那边今天过得怎么样呀？有没有好好吃饭？记得早点休息，别又熬到半夜。", "minParts": 2, "maxParts": 4, "maxChars": 60 } },
        { "expectSilence": { "to": "*", "afterMs": 3000 } }
      ]
    },
    {
      "id": "H2",
      "title": "beijing-time-in-note: the model is told the real time as Beijing time, and no UTC timestamp",
      "model": [
        { "match": "MOCK-H2", "reply": "MOCK-REPLY-H2 好" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-H2 现在几点了" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-H2 好" } },
        { "expectPrompt": { "userText": "MOCK-H2", "contains": "（北京时间）", "in": "context" } },
        { "expectPrompt": { "userText": "MOCK-H2", "absent": "世界时间", "in": "context" } },
        { "expectBeijingTime": { "userText": "MOCK-H2" } }
      ]
    },
    {
      "id": "H3",
      "title": "propose-rejection-is-actionable: a rejected proposal tells the model how to correct it, and the corrected one is remembered",
      "model": [
        { "match": "MOCK-H3", "propose": { "type": "learning.note", "payload": { "text": "MOCK-H3-{run} 搬家日期 学习笔记", "quote": "我下个月 5 号搬家" } }, "retry": { "type": "fact.report", "payload": { "key": "MOCK-H3-{run} 搬家日期", "value": "下个月 5 号", "quote": "我下个月 5 号搬家" } }, "reply": "MOCK-REPLY-H3 记下了" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-H3 MOCK-H3-{run} 请记住：我下个月 5 号搬家" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-H3 记下了" } },
        { "expectToolResult": { "userText": "MOCK-H3", "nth": 1, "contains": "\"status\":\"rejected\"" } },
        { "expectToolResult": { "userText": "MOCK-H3", "nth": 1, "contains": "conversation_policy_kind_denied" } },
        { "expectToolResult": { "userText": "MOCK-H3", "nth": 1, "contains": "聊天里不能用 learning.note；改用 fact.report" } },
        { "expectToolResult": { "userText": "MOCK-H3", "nth": 2, "contains": "\"status\":\"accepted\"", "absent": "rejected" } },
        { "expectMemory": { "person": "MOCK-A", "contains": "MOCK-H3-{run} 搬家日期 下个月 5 号", "absent": "MOCK-H3-{run} 搬家日期 学习笔记" } }
      ]
    },
    {
      "id": "H4",
      "title": "normalized-value-is-stored: a relative date she resolved to a concrete one is remembered at once, traced to the words it came from, and reaches nobody else",
      "model": [
        { "match": "MOCK-H4 请记住", "propose": { "type": "fact.report", "payload": { "key": "MOCK-H4-{run} 去上海", "value": "2026-12-05", "quote": "我下个月 5 号去上海" } }, "reply": "MOCK-REPLY-H4 记下了" },
        { "match": "MOCK-H4", "reply": "MOCK-REPLY-H4 好" }
      ],
      "steps": [
        { "say": { "from": "MOCK-A", "text": "MOCK-H4 请记住 MOCK-H4-{run}：我下个月 5 号去上海，待三天" } },
        { "expectReply": { "to": "MOCK-A", "contains": "MOCK-REPLY-H4 记下了" } },
        { "expectToolResult": { "userText": "MOCK-H4 请记住", "nth": 1, "contains": "\"status\":\"accepted\"", "absent": "rejected" } },
        { "expectProvenance": { "person": "MOCK-A", "contains": "MOCK-H4-{run} 去上海 2026-12-05", "source": "MOCK-H4-{run}：我下个月 5 号去上海" } },
        { "say": { "from": "MOCK-B", "text": "MOCK-H4 别人追问：去上海 是哪天" } },
        { "expectReply": { "to": "MOCK-B", "contains": "MOCK-REPLY-H4 好" } },
        { "expectPrompt": { "userText": "别人追问", "absent": "MOCK-H4-{run}" } },
        { "expectMemory": { "person": "MOCK-B", "absent": "MOCK-H4-{run}" } }
      ]
    }
  ]
}
