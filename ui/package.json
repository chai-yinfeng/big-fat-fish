{
  "name": "@local/companion-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "大肥鱼可选角色 UI：鲸鱼娘头像、ASR/TTS/状态三模块面板。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.webp",
    "NOTICE.md",
    "LICENSE.whale-musume",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
